# ============================================
# OPENMONETIS - Variáveis de Ambiente (Supabase 100% API)
# ============================================

# === Supabase (obrigatório) ===
# Cliente (login/OAuth no browser):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Servidor (Server Actions, API Companion, Storage admin) — copie em Project Settings → API:
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=openmonetis-attachments
# NUNCA defina service_role com prefixo NEXT_PUBLIC_ (vazaria no bundle do cliente).

# No painel Supabase → Authentication → URL Configuration:
# - Site URL: http://localhost:3050 (dev) ou sua URL de produção
# - Redirect URLs: http://localhost:3050/auth/callback (fluxo Supabase, se usar)

# === App ===
APP_PORT=3050
APP_URL=http://localhost:3050
# Espelho no cliente (OAuth Google). Se omitido, next.config usa APP_URL.
# NEXT_PUBLIC_APP_URL=http://localhost:3050
# Gere com: openssl rand -base64 32 — usado para criptografia de segredos locais (IA, tokens de upload)
APP_SECRET=
DISABLE_SIGNUP=false

# === OAuth Google (login direto no app — popup accounts.google.com) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opcional: espelho público (senão next.config usa GOOGLE_CLIENT_ID)
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# No Google Cloud Console → Credentials → OAuth 2.0 Client ID (tipo Web application):
#   Origens JavaScript autorizadas:
#     http://localhost:3050
#   URIs de redirecionamento autorizados (obrigatório se popup falhar ou em iframe/preview):
#     http://localhost:3050/auth/google/callback
# Se abrir o app por 127.0.0.1 ou outro host, cadastre as mesmas URLs com esse host.
# Abra o app sempre pela mesma URL cadastrada (evite misturar localhost e 127.0.0.1).
# O login Google é validado no Next.js (não precisa ativar provider Google no painel Supabase).

# === S3 compatível (opcional — ignorado se Supabase Storage estiver configurado) ===
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=openmonetis-attachments
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# === Email (Opcional) ===
RESEND_API_KEY=
RESEND_FROM_EMAIL="OpenMonetis <noreply@seudominio.com>"

# === Multi-Domínio (Opcional) ===
# PUBLIC_DOMAIN=openmonetis.com

# === Analytics (Opcional) ===
UMAMI_URL=
UMAMI_WEBSITE_ID=

# === IA (Opcional — ou configure em Ajustes → IA) ===
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
OPENROUTER_API_KEY=
